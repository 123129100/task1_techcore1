
&НаКлиенте
Процедура ЗагрузитьДанные(Команда)
	// Проверяем, что файл выбран
	Если ПустаяСтрока(ПутьКФайлу) Тогда
		Сообщить("Сначала выберите файл!", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	
	// Вызываем серверную процедуру загрузки
	ЗагрузитьДанныеИзФайлаНаСервере(ПутьКФайлу);
	КонецПроцедуры
&НаКлиенте
Функция	ВыборФайла(Элемент, Заголовок, Фильтр) Экспорт
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбораФайла.Фильтр                      = Фильтр;
	ДиалогВыбораФайла.Заголовок                   = Заголовок;
	ДиалогВыбораФайла.ПредварительныйПросмотр     = Ложь;
	ДиалогВыбораФайла.ИндексФильтра               = 0;
	ДиалогВыбораФайла.ПолноеИмяФайла              = Элемент.ТекстРедактирования;
	ДиалогВыбораФайла.ПроверятьСуществованиеФайла = Истина;
	
	Если ДиалогВыбораФайла.Выбрать() Тогда
		ДанныеВыбора = ДиалогВыбораФайла.ПолноеИмяФайла;
	Иначе
		ДанныеВыбора = Элемент.ТекстРедактирования; 	
	КонецЕсли;	
	
	Возврат(ДанныеВыбора);
	
КонецФункции 

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ПутьКФайлу = ВыборФайла(Элемент,"Укажите загружаемый файл ","Файлы Excel (*.xlsx;*xls)|*.xlsx;*xls");

КонецПроцедуры
&НаСервере
Процедура ЗагрузитьДанныеИзФайлаНаСервере(ПутьКФайлу)
	// Очищаем старые данные
	Объект.ДанныеФайла.Очистить();
	
	Попытка
		// 1. Создаем табличный документ и читаем файл
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ТабличныйДокумент.Прочитать(ПутьКФайлу, СпособЧтенияЗначенийТабличногоДокумента.Значение);
		
		// 2. Получаем область с данными
		Область = ТабличныйДокумент.Область();
		
		// 3. Используем ПостроительЗапроса для преобразования в таблицу значений
		ПЗ = Новый ПостроительЗапроса;
		ПЗ.ИсточникДанных = Новый ОписаниеИсточникаДанных(Область);
		ПЗ.ДобавлениеПредставлений = ТипДобавленияПредставлений.НеДобавлять;
		ПЗ.ЗаполнитьНастройки();
		ПЗ.Выполнить();
		
		// 4. Выгружаем результат во ВРЕМЕННУЮ таблицу
		ТаблицаИзФайла = ПЗ.Результат.Выгрузить();
		
	Исключение
		Сообщить("Ошибка при чтении файла: " + ОписаниеОшибки(), СтатусСообщения.Внимание);
		Возврат;
	КонецПопытки;
	
	// Проверяем, что данные есть
	Если ТаблицаИзФайла.Количество() = 0 Тогда
		Сообщить("Файл пуст или не содержит данных.", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	
	// Определяем индексы колонок по заголовкам (первая строка)
	Заголовки = ТабличныйДокумент.Область(1,1).Текст; 
	
	
	
	// Исправлено: передаем массив значений (через запятую) 
МассивЗаголовков=Новый Массив;
МассивЗаголовков.Добавить("ФИО"); 
МассивЗаголовков.Добавить("Должность");
МассивЗаголовков.Добавить("Email");
МассивЗаголовков.Добавить("Телефон");
МассивЗаголовков.Добавить("Пол");
МассивЗаголовков.Добавить("Отдел");
МассивЗаголовков.Добавить("ДатаРождения");
   СтукураИндексов=Новый Структура();
   
	Для Номер = 1 По ТабличныйДокумент.ШиринаТаблицы Цикл
     Заголовки = ТабличныйДокумент.Область(1,Номер).Текст;
	 
	 Для Каждого ЗаголовокНаим Из МассивЗаголовков Цикл
		 
		 
	Найдено=	 СтрНайти(Заголовки, ЗаголовокНаим); 
	Если Найдено=1 Тогда 
     
		СтукураИндексов.Вставить(ЗаголовокНаим,Номер-1); 
		
      КонецЕсли;
	КонецЦикла;	
	
	КонецЦикла;
	// Проверяем наличие обязательного поля
	Если СтукураИндексов.ФИО   = -1 Тогда
		Сообщить("В файле не найдена колонка 'ФИО'!", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	
	// Создаем структуру для ускоренного добавления строк
	// ВАЖНО: добавляем строки в реквизит формы "ДанныеФайла"
	Для НомерСтроки = 0 По ТаблицаИзФайла.Количество() - 1 Цикл
		
		СтрокаДанных = ТаблицаИзФайла[НомерСтроки]; 
		
		НоваяСтрока = Объект.ДанныеФайла.Добавить();  // ← добавляем в реквизит формы
		
		Попытка
			// Получаем значения по индексам
			ФИО = ПолучитьЗначениеПоИндексу(СтрокаДанных, СтукураИндексов.ФИО);
			Если ПустаяСтрока(ФИО) Тогда
				ВызватьИсключение "Не заполнено обязательное поле 'ФИО'";
			КонецЕсли;
			НоваяСтрока.ДанныеФайла_ФИО = ФИО;
			
			НоваяСтрока.ДанныеФайла_Должность = ПолучитьЗначениеПоИндексу(СтрокаДанных, СтукураИндексов.Должность);
			НоваяСтрока.ДанныеФайла_Телефон = ПолучитьЗначениеПоИндексу(СтрокаДанных,СтукураИндексов.Телефон);
			НоваяСтрока.ДанныеФайла_Email = ПолучитьЗначениеПоИндексу(СтрокаДанных, СтукураИндексов.Email);
			НоваяСтрока.ДанныеФайла_Пол = ПолучитьЗначениеПоИндексу(СтрокаДанных, СтукураИндексов.Пол);
			НоваяСтрока.ДанныеФайла_Отдел = ПолучитьЗначениеПоИндексу(СтрокаДанных,СтукураИндексов.Отдел);
			 НоваяСтрока.ДанныеФайла_ДатаРождения=ПолучитьЗначениеПоИндексу(СтрокаДанных,СтукураИндексов.ДатаРождения);
						
		Исключение
					Сообщить(ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	Сообщить("Загружено строк: " + Объект.ДанныеФайла.Количество(), СтатусСообщения.Информация);

	КонецПроцедуры

&НаСервере
Функция ПолучитьЗначениеПоИндексу(СтрокаДанных, Индекс)
	Если Индекс = -1  Тогда
		Возврат "";
	КонецЕсли;
	Значение = СтрокаДанных[Индекс];
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

&НаКлиенте
Процедура СоздатьСотрудников(Команда)
	СоздатьСотрудниковНаСервере();
КонецПроцедуры 


&НаСервере
Процедура СоздатьСотрудниковНаСервере()
МенеджерСправочника = Справочники.Сотрудники;

// Создаём новый элемент
Для НомерСтроки = 0 По Объект.ДанныеФайла.Количество() - 1 Цикл 
НовыйЭлемент = МенеджерСправочника.СоздатьЭлемент();
	
СтрокаДанных = Объект.ДанныеФайла[НомерСтроки];

Если СтрокаДанных.ДанныеФайла_Пометка = Истина Тогда 
НовыйЭлемент.Наименование =СтрокаДанных.ДанныеФайла_ФИО ;

НовыйЭлемент.Отдел =Справочники.Отделы.НайтиПоНаименованию( Строка(СтрокаДанных.ДанныеФайла_Отдел)) ;
НовыйЭлемент.Должность =Справочники.Должности.НайтиПоНаименованию(СтрокаДанных.ДанныеФайла_Должность) ;
НовыйЭлемент.Телефон =СтрокаДанных.ДанныеФайла_Телефон ;
НовыйЭлемент.Email =СтрокаДанных.ДанныеФайла_Email ;



НовыйЭлемент.СтатусСотрудника =Перечисления.СтатусСотрудника.Работает ; 
Если СтрокаДанных.ДанныеФайла_СтатусСотр="Работает" Тогда 
	НовыйЭлемент.СтатусСотрудника = Перечисления.СтатусСотрудника.Работает

ИначеЕсли  СтрокаДанных.ДанныеФайла_СтатусСотр="В Декрете"  Тогда
	  НовыйЭлемент.СтатусСотрудника = Перечисления.СтатусСотрудника.ВДекретномОтпуске;   
  Иначе 
	   НовыйЭлемент.СтатусСотрудника = Перечисления.СтатусСотрудника.Уволен;  
КонецЕсли;



НовыйЭлемент.ДатаРождения =Дата(СтрокаДанных.ДанныеФайла_ДатаРождения) ; 
Если СтрокаДанных.ДанныеФайла_Пол="Женский" Тогда 
	НовыйЭлемент.Пол = Перечисления.Пол.Женский 

Иначе  
	  НовыйЭлемент.Пол = Перечисления.Пол.Мужской
	;
КонецЕсли;
Попытка	
	НовыйЭлемент.Записать();
Исключение

Сообщить(ОписаниеОшибки()); 

КонецПопытки;
КонецЕсли;
КонецЦикла;

	
КонецПроцедуры

