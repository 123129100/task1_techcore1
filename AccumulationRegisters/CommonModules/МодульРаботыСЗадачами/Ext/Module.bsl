Функция КоличествоЗадачПользователя(Пользователь = Неопределено) Экспорт
    
    Если Пользователь = Неопределено Тогда
        Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
    КонецЕсли;
    
    Запрос = Новый Запрос;
  Запрос.Текст = 
"ВЫБРАТЬ
|	Задача.Ссылка КАК Ссылка
|ИЗ
|	Задача.ЗадачаИсполнителя КАК Задача
|ГДЕ
|	Задача.Исполнитель = &ТекущийПользователь
|	И Задача.Выполнена = ЛОЖЬ";     
  
  
  
    
    Запрос.УстановитьПараметр("ТекущийПользователь",Справочники.Пользователи.НайтиПоНаименованию(Пользователь));
    
    // Считаем количество записей в цикле
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Количество = 0;
    Пока Выборка.Следующий() Цикл
        Количество = Количество + 1;
    КонецЦикла;
    
    Возврат Количество;
    
КонецФункции 
 Функция ПолучитьВсеЗадачиССылками(Пользователь = Неопределено) Экспорт
    
 Если Пользователь = Неопределено Тогда
        Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
    КонецЕсли;    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |    Задача.Ссылка КАК Ссылка,
    |    Задача.Наименование КАК Наименование
    |ИЗ
    |    Задача.ЗадачаИсполнителя КАК Задача
    |ГДЕ
    |    Задача.Исполнитель = &ТекущийПользователь
    |    И Задача.Выполнена = ЛОЖЬ";
    
 Запрос.УстановитьПараметр("ТекущийПользователь",Справочники.Пользователи.НайтиПоНаименованию(Пользователь));
    
       Результат = Запрос.Выполнить().Выбрать();
    
    // ✅ Формируем массив структур с готовыми навигационными ссылками
    МассивЗадач = Новый Массив;
    Пока Результат.Следующий() Цикл
        Строка = Новый Структура("Наименование, Ссылка");
        Строка.Наименование = Результат.Наименование;
        Строка.Ссылка = Результат.Ссылка;  // ✅ на сервере
        МассивЗадач.Добавить(Строка);
    КонецЦикла;
    
    Возврат МассивЗадач;
    
КонецФункции
Функция ПолучитьНавигационнуюСсылкуСпискаЗадач() Экспорт
    
    // ✅ Передаём объект метаданных, а не строку с именем формы
    Возврат ПолучитьНавигационнуюСсылку(Метаданные.Задачи.ЗадачаИсполнителя);
    
КонецФункции
Функция ЭтоАдминистратор() Экспорт
    
    // Эта функция выполняется на сервере, где Пользователи доступны
    Возврат ПользователиИнформационнойБазы.ТекущийПользователь().Имя = "Администратор";
    
КонецФункции         
Функция ПолучитьТекущегоПользователя() Экспорт
    
    // Ищем пользователя в справочнике
    ИмяПользователя = ИмяПользователя();
    ТекущийПользователь = Справочники.Пользователи.НайтиПоНаименованию(ИмяПользователя);
    
    // Если не нашли — создаем
    Если Не ЗначениеЗаполнено(ТекущийПользователь) Тогда
        НовыйПользователь = Справочники.Пользователи.СоздатьЭлемент();
        НовыйПользователь.Наименование = ИмяПользователя;
        НовыйПользователь.Записать();
        ТекущийПользователь = НовыйПользователь.Ссылка;
    КонецЕсли;
    
    // Записываем в параметр сеанса
    ПараметрыСеанса.ТекущийПользователь = ТекущийПользователь;
    
    Возврат ТекущийПользователь;
    
КонецФункции