// СправочникОбъект.Номенклатура

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    Если ПустаяСтрока(Наименование) Тогда
        Сообщить("Введите наименование номенклатуры!");
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    
    Если ПустаяСтрока(Артикул) Тогда
        Сообщить("Введите артикул!");
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    
    Если ЕдиницаИзмерения = "" Тогда
        ЕдиницаИзмерения = "шт";
    КонецЕсли;
КонецПроцедуры