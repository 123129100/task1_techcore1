		<query>ВЫБРАТЬ
    Реализация.Менеджер КАК Менеджер,
    Реализация.Покупатель КАК Клиент,
    Реализация.Дата КАК ДатаПродажи,
    РеализацияТовары.Номенклатура КАК Товар,
    СУММА(РеализацияТовары.Количество) КАК Количество,
    СУММА(РеализацияТовары.Сумма) КАК Выручка,
    СУММА(РеализацияТовары.Себестоимость) КАК Себестоимость,
    СУММА(РеализацияТовары.Сумма - РеализацияТовары.Себестоимость) КАК Прибыль
ИЗ
    Документ.Реализация КАК Реализация
        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Реализация.Товары КАК РеализацияТовары
        ПО Реализация.Ссылка = РеализацияТовары.Ссылка
ГДЕ
    Реализация.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаКонца
    И Реализация.Проведен = ИСТИНА
    

    И (&amp;Менеджер = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) 
        ИЛИ Реализация.Менеджер = &amp;Менеджер)
    

    

    И (&amp;Товар = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) 
        ИЛИ РеализацияТовары.Номенклатура = &amp;Товар)
    
    И (&amp;СуммаОт = 0 
        ИЛИ РеализацияТовары.Сумма &gt;= &amp;СуммаОт)
    
    И (&amp;СуммаДо = 0 
        ИЛИ РеализацияТовары.Сумма &lt;= &amp;СуммаДо)

СГРУППИРОВАТЬ ПО
    Реализация.Менеджер,
    Реализация.Покупатель,
    Реализация.Дата,
    РеализацияТовары.Номенклатура

УПОРЯДОЧИТЬ ПО
    Менеджер</query>
