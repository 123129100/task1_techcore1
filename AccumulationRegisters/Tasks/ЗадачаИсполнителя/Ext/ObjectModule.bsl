Процедура ПриВыполнении(Отказ)
    
    // Записываем в историю согласований
    МенеджерЗаписи = РегистрыСведений.ИсторияСогласований.СоздатьМенеджерЗаписи();
    МенеджерЗаписи.БизнесПроцесс = БизнесПроцесс;
    МенеджерЗаписи.Сотрудник = Исполнитель;
    МенеджерЗаписи.Дата = ТекущаяДата();
    МенеджерЗаписи.Результат = ?(Выполнена, "Выполнено", "Не выполнено");
    МенеджерЗаписи.Записать();
    
КонецПроцедуры