		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Реализация.Покупатель КАК Клиент,
	Реализация.Дата КАК Дата,
	РеализацияТовары.Количество КАК Количество,
	СУММА(РеализацияТовары.Себестоимость) КАК Себестоимость,
	РеализацияТовары.Номенклатура КАК Номенклатура,
	СУММА(РеализацияТовары.Сумма) КАК Выручка,
	СУММА(РеализацияТовары.Сумма - РеализацияТовары.Себестоимость) КАК Прибыль
	Поместить втПродажи
ИЗ
	Документ.Реализация КАК Реализация
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Реализация.Товары КАК РеализацияТовары
		ПО (Реализация.Ссылка = РеализацияТовары.Ссылка)
ГДЕ
	Реализация.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаКонца

СГРУППИРОВАТЬ ПО
	Реализация.Покупатель,
	Реализация.Дата,
	РеализацияТовары.Количество,
	РеализацияТовары.Номенклатура
	
	
ИНДЕКСИРОВАТЬ ПО  Реализация.Ссылка

;
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втПродажи.Клиент КАК Клиент,
	втПродажи.Выручка КАК Выручка,
	втПродажи.Себестоимость КАК Себестоимость,
	втПродажи.Прибыль КАК Прибыль,
	втПродажи.Выручка / Общ.ОбщаяВыручка * 100 КАК ДоляПроцентах,
	ВЫБОР
		КОГДА втПродажи.Выручка / Общ.ОбщаяВыручка * 100 &gt;= 80
			ТОГДА "A"
		КОГДА втПродажи.Выручка / Общ.ОбщаяВыручка * 100 &gt;= 50
			ТОГДА "B"
		ИНАЧЕ "C"
	КОНЕЦ КАК КлассABC
ИЗ
	втПродажи КАК втПродажи
		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			СУММА(втПродажи.Выручка) КАК ОбщаяВыручка
		ИЗ
			втПродажи КАК втПродажи) КАК Общ
		ПО (ИСТИНА)
</query>
