			<field>Номенклатура</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    Реализация.Покупатель КАК Покупатель,
    Реализация.Дата КАК Дата,
    РеализацияТовары.Количество КАК Количество,
    РеализацияТовары.Сумма КАК Сумма,
    РеализацияТовары.Себестоимость КАК Себестоимость,
    РеализацияТовары.Номенклатура КАК Номенклатура
ИЗ
    Документ.Реализация КАК Реализация
        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Реализация.Товары КАК РеализацияТовары
        ПО Реализация.Ссылка = РеализацияТовары.Ссылка
ГДЕ
    Реализация.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаКонца
    И Реализация.Проведен = ИСТИНА
                                              
    
    И ( 
         &amp;Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
        ИЛИ РеализацияТовары.Номенклатура = &amp;Номенклатура)
    
    И (&amp;СуммаОт = 0 
        ИЛИ РеализацияТовары.Сумма &gt;= &amp;СуммаОт)
    

    И (&amp;СуммаДо = 0 
        ИЛИ РеализацияТовары.Сумма &lt;= &amp;СуммаДо)
    
    И (&amp;КоличествоОт = 0 
        ИЛИ РеализацияТовары.Количество &gt;= &amp;КоличествоОт)

УПОРЯДОЧИТЬ ПО
    Реализация.Дата УБЫВ,
    Реализация.Покупатель,
    РеализацияТовары.Номенклатура</query>
