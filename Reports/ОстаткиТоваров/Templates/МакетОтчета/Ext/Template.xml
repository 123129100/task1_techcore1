		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ТоварыНаСкладе.Склад КАК Склад,
	ТоварыНаСкладе.Номенклатура КАК Номенклатура,
	СУММА(ТоварыНаСкладе.Количество) КАК Остаток,
	СУММА(ТоварыНаСкладе.Сумма) КАК СуммаОстатка,
	ВЫБОР
		КОГДА СУММА(ТоварыНаСкладе.Количество) &lt; Номенклатура.МинимальныйОстаток
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК КритическийОстаток,
	ТоварыНаСкладе.Номенклатура.Наименование
ИЗ
	РегистрНакопления.ТоварыНаСкладе КАК ТоварыНаСкладе
ГДЕ
	ТоварыНаСкладе.Период &lt;= &amp;Период
	И (ТоварыНаСкладе.Склад = &amp;Склад
	ИЛИ &amp;Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка))
СГРУППИРОВАТЬ ПО
	ТоварыНаСкладе.Склад,
	ТоварыНаСкладе.Номенклатура,
	ТоварыНаСкладе.Номенклатура.Наименование</query>
