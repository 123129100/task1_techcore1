// Функция проверки существования клиента с таким ИНН
// 
// Параметры:
//   ИНН - Строка - ИНН для поиска
//   ИсключитьСсылку - СправочникСсылка.Клиенты - ссылка клиента, которую нужно исключить из поиска (для проверки дублей при редактировании)
// 
// Возвращаемое значение:
//   СправочникСсылка.Клиенты - ссылка на найденного клиента, или Неопределено если клиент не найден
//
Функция НайтиПоИНН(ИНН, ИсключитьСсылку = Неопределено) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   Клиенты.Ссылка КАК Ссылка
    |ИЗ
    |   Справочник.Клиенты КАК Клиенты
    |ГДЕ
    |   Клиенты.ИНН = &ИНН";
    
    Если ИсключитьСсылку <> Неопределено Тогда
        Запрос.Текст = Запрос.Текст + " И Клиенты.Ссылка <> &ИсключитьСсылку";
        Запрос.УстановитьПараметр("ИсключитьСсылку", ИсключитьСсылку);
    КонецЕсли;
    
    Запрос.УстановитьПараметр("ИНН", ИНН);
    Результат = Запрос.Выполнить();
    
    Если Результат.Пустой() Тогда
        Возврат Неопределено;
    Иначе
        Выборка = Результат.Выбрать();
        Выборка.Следующий();
        Возврат Выборка.Ссылка;
    КонецЕсли;
КонецФункции

// Проверка при записи (вызывается в модуле объекта)
// 
// Параметры:
//   Объект - СправочникОбъект.Клиенты - проверяемый объект справочника
//   Отказ - Булево - признак отказа от записи (передается по ссылке)
// 
// Возвращаемое значение:
//   Булево - Истина, если проверка пройдена успешно (дубли не найдены), Ложь - если найден дублирующий клиент
//
Функция ПриЗаписиПроверитьДубли(Объект, Отказ) Экспорт
    Если ПустаяСтрока(Объект.ИНН) Тогда
        Возврат Истина; // пропускаем, если ИНН не заполнен
    КонецЕсли;
    
    Существующий = НайтиПоИНН(Объект.ИНН, Объект.Ссылка);
    Если Существующий <> Неопределено Тогда
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "Клиент с таким ИНН уже существует: " + Существующий;
        Сообщение.Поле = "ИНН";
        Сообщение.Сообщить();
        Отказ = Истина;
        Возврат Ложь;
    КонецЕсли;
    Возврат Истина;
КонецФункции