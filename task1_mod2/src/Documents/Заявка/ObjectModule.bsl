// ДокументОбъект.Заявка

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
   
    
      Если ОбменДанными.Загрузка Тогда
        Возврат;
    КонецЕсли;
    Если Статус = Перечисления.СтатусыЗаявок.ПустаяСсылка() Тогда
        Статус = Перечисления.СтатусыЗаявок.Новая;
    КонецЕсли;
    
    // Проверка заполнения обязательных полей
    Если Клиент = Справочники.Клиенты.ПустаяСсылка() Тогда
        Сообщить("Выберите клиента!");
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    
    Если Услуги.Количество() = 0 Тогда
        Сообщить("Добавьте хотя бы одну услугу!");
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    
    
  
    
    
КонецПроцедуры




Функция ПолучитьПечатнуюФорму() Экспорт
    // Создаем табличный документ
    
 
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.ОтображатьСетку = Ложь;
    ТабДок.ТолькоПросмотр = Истина;
    
   
    Макет = ПолучитьМакет("ПечатнаяФормаЗаявки");
    Если Макет = Неопределено Тогда
        Сообщить("Макет 'ПечатнаяФорма' не найден!");
        Возврат Неопределено;
    КонецЕсли;
    
  
    ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
    ОбластьШапка.Параметры.Номер = Номер;
    ОбластьШапка.Параметры.Дата = Формат(Дата, "ДФ=dd.MM.yyyy");
    ТабДок.Вывести(ОбластьШапка);
    ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
    
  
    ОбластьКлиент = Макет.ПолучитьОбласть("Клиент");
    ОбластьКлиент.Параметры.Клиент = Клиент.Наименование;
    ОбластьКлиент.Параметры.Телефон = Клиент.Телефон;
    ОбластьКлиент.Параметры.Email = Клиент.Email;
    ОбластьКлиент.Параметры.Статус = Статус;
    
 
    
   
    ТабДок.Вывести(ОбластьКлиент);
    ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
    
    
    ОбластьШапкаТЧ = Макет.ПолучитьОбласть("ЗаголовкиТЧ");
    ТабДок.Вывести(ОбластьШапкаТЧ);
    
   
    Если Услуги.Количество() > 0 Тогда
        ОбластьСтрокаТЧ = Макет.ПолучитьОбласть("СтрокиТЧ");
        НомерСтроки = 1;
        Для Каждого СтрокаТЧ Из Услуги Цикл
            ОбластьСтрокаТЧ.Параметры.Номер = НомерСтроки;
            ОбластьСтрокаТЧ.Параметры.Услуга = СтрокаТЧ.Услуга;
            ОбластьСтрокаТЧ.Параметры.Количество = Формат(СтрокаТЧ.Количество, "ЧДЦ=2");
            ОбластьСтрокаТЧ.Параметры.Цена = Формат(СтрокаТЧ.Цена, "ЧДЦ=2");
            ОбластьСтрокаТЧ.Параметры.Сумма = Формат(СтрокаТЧ.Сумма, "ЧДЦ=2");
            ТабДок.Вывести(ОбластьСтрокаТЧ);
            НомерСтроки = НомерСтроки + 1;
        КонецЦикла;
    Иначе
       
        ОбластьСтрокаТЧ = Макет.ПолучитьОбласть("СтрокиТЧ");
        ОбластьСтрокаТЧ.Параметры.Номер = "";
        ОбластьСтрокаТЧ.Параметры.Услуга = "Нет услуг";
        ОбластьСтрокаТЧ.Параметры.Количество = "";
        ОбластьСтрокаТЧ.Параметры.Цена = "";
        ОбластьСтрокаТЧ.Параметры.Сумма = "";
        ТабДок.Вывести(ОбластьСтрокаТЧ);
    КонецЕсли;
    
    
    ОбластьИтог = Макет.ПолучитьОбласть("Итог");
    ОбластьИтог.Параметры.Итого = Формат(СуммаИтог, "ЧДЦ=2");
    ТабДок.Вывести(ОбластьИтог);
    ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
    

    ТабДок.ФиксацияСлева = 0;
    ТабДок.ШиринаСтраницы = 8; 
    
    Возврат ТабДок;
КонецФункции




