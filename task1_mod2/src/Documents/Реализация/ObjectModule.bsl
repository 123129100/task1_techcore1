Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    // Проверка заполнения
    Если Покупатель = Справочники.Контрагенты.ПустаяСсылка() Тогда
        Сообщить("Выберите покупателя!");
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    
    Если Склад = Справочники.Склады.ПустаяСсылка() Тогда
        Сообщить("Выберите склад!");
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    
    Если Товары.Количество() = 0 Тогда
        Сообщить("Добавьте хотя бы один товар!");
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    
    // Пересчет сумм
    ПересчитатьСуммы();
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    // Проверка остатков перед проведением
    Если Не ПроверитьОстатки() Тогда
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    
    // Расчет себестоимости
    РассчитатьСебестоимость();
    
    // Формирование движений
    СформироватьДвижения();
КонецПроцедуры

Процедура ОбработкаОтменыПроведения(Отказ, РежимОтменыПроведения)
    Движения.ТоварыНаСкладе.Очистить();
КонецПроцедуры

Функция ПроверитьОстатки() Экспорт
    Для Каждого СтрокаТЧ Из Товары Цикл
        ТекущийОстаток = ПолучитьОстаток(СтрокаТЧ.Номенклатура, Склад, Дата);
        
        Если ТекущийОстаток < СтрокаТЧ.Количество Тогда
            Текст = "Недостаточно товара """ + 
                    СтрокаТЧ.Номенклатура.Наименование + 
                    """ на складе """ + 
                    Склад.Наименование + 
                    """. Остаток: " + 
                    Формат(ТекущийОстаток, "ЧДЦ=2") + 
                    ", требуется: " + 
                    Формат(СтрокаТЧ.Количество, "ЧДЦ=2");
            Сообщить(Текст);
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    
    Возврат Истина;
КонецФункции

Функция ПолучитьОстаток(Номенклатура, Склад, ДатаПериода)
    Запрос = Новый Запрос;
    Запрос.Текст = "
    |ВЫБРАТЬ
    |    СУММА(ТоварыНаСкладе.Количество) КАК Остаток
    |ИЗ
    |    РегистрНакопления.ТоварыНаСкладе КАК ТоварыНаСкладе
    |ГДЕ
    |    ТоварыНаСкладе.Номенклатура = &Номенклатура
    |    И ТоварыНаСкладе.Склад = &Склад
    |    И ТоварыНаСкладе.Период <= &Период
    |";
    
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Запрос.УстановитьПараметр("Склад", Склад);
    Запрос.УстановитьПараметр("Период", ДатаПериода);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Остаток;
    КонецЕсли;
    
    Возврат 0;
КонецФункции

Процедура РассчитатьСебестоимость()
    Для Каждого СтрокаТЧ Из Товары Цикл
        // Получаем себестоимость из регистра
        СтрокаТЧ.Себестоимость = ПолучитьСебестоимостьТовара(СтрокаТЧ.Номенклатура);
    КонецЦикла;
КонецПроцедуры

