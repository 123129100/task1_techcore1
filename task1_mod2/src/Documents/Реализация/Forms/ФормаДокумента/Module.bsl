// ФормаДокумента.Реализация

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
    Индекс = Элементы.Товары.ТекущаяСтрока;
    Если Индекс <> Неопределено Тогда
        // Сначала пересчитываем сумму
        ПересчитатьСтрокуНаСервере(Индекс);
        
        // Затем проверяем остаток
        ПроверитьОстатокНаСервере(Индекс);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПродажиПриИзменении(Элемент)
    Индекс = Элементы.Товары.ТекущаяСтрока;
    Если Индекс <> Неопределено Тогда
        ПересчитатьСтрокуНаСервере(Индекс);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСтрокуНаСервере(ИндексСтроки)
    СтрокаТЧ = Объект.Товары[ИндексСтроки];
    СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.ЦенаПродажи;
КонецПроцедуры

&НаСервере
Процедура ПроверитьОстатокНаСервере(ИндексСтроки)
    СтрокаТЧ = Объект.Товары[ИндексСтроки];
    Остаток = Объект.ПолучитьОстаток(СтрокаТЧ.Номенклатура, Объект.Склад, Объект.Дата);
    
    Если Остаток < СтрокаТЧ.Количество Тогда
        Сообщить("⚠️ Недостаточно товара! Остаток: " + Остаток);
    КонецЕсли;
КонецПроцедуры