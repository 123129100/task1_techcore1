// Отчет.СебестоимостьТоваров

Функция РассчитатьСреднююСебестоимость(Номенклатура, ДатаПериода)
    Запрос = Новый Запрос;
    Запрос.Текст = "
    |ВЫБРАТЬ
    |    СУММА(ТоварыНаСкладе.Сумма) / СУММА(ТоварыНаСкладе.Количество) КАК СредняяСебестоимость
    |ИЗ
    |    РегистрНакопления.ТоварыНаСкладе КАК ТоварыНаСкладе
    |ГДЕ
    |    ТоварыНаСкладе.Номенклатура = &Номенклатура
    |    И ТоварыНаСкладе.Период <= &Период
    |";
    
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Запрос.УстановитьПараметр("Период", ДатаПериода);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Если Выборка.Следующий() И Выборка.СредняяСебестоимость <> Неопределено Тогда
        Возврат Выборка.СредняяСебестоимость;
    КонецЕсли;
    
    // Если данных нет - берем из справочника
    Возврат Номенклатура.Себестоимость;
КонецФункции