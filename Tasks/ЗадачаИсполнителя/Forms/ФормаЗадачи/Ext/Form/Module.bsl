Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	 // Проверяем, была ли это новая задача
    Если НЕ Параметры.Ключ.Пустая() Тогда
        ПоказатьОповещениеПользователя(
            "Новая задача", 
            , 
            "Вам поступила задача: " + Объект.Описание,
            ,
            СтатусОповещенияПользователя.Важный
        );
	КонецЕсли;
