&НаСервере
Процедура ОбновитьСтатусСтрокиНаСервере(ИндексСтроки)
    СтрокаТЧ = Объект.Товары[ИндексСтроки];
    
    // Если ОтгруженоКоличество не задано, считаем = 0
    Если СтрокаТЧ.ОтгруженоКоличество = Неопределено Тогда
        СтрокаТЧ.ОтгруженоКоличество = 0;
    КонецЕсли;
    
    // Обновляем остаток
    СтрокаТЧ.ОстатокКОтгрузке = СтрокаТЧ.Количество - СтрокаТЧ.ОтгруженоКоличество;
    
    // Устанавливаем статус
    Если СтрокаТЧ.ОтгруженоКоличество <= 0 Тогда
        СтрокаТЧ.СтатусОтгрузки = Перечисления.СтатусыОтгрузки.ОжидаетОтгрузки;
    ИначеЕсли СтрокаТЧ.ОтгруженоКоличество < СтрокаТЧ.Количество Тогда
        СтрокаТЧ.СтатусОтгрузки = Перечисления.СтатусыОтгрузки.Частично;
    Иначе
        СтрокаТЧ.СтатусОтгрузки = Перечисления.СтатусыОтгрузки.Отгружено;
    КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ТоварыЦенаПродажиПриИзменении(Элемент)
    Индекс = Элементы.Товары.ТекущаяСтрока;
    Если Индекс <> Неопределено Тогда
        ПересчитатьСтрокуНаСервере(Индекс);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСтрокуНаСервере(ИндексСтроки)
    СтрокаТЧ = Объект.Товары[ИндексСтроки];
    
    // Если ОтгруженоКоличество не задано, считаем = 0
    Если СтрокаТЧ.ОтгруженоКоличество = Неопределено Тогда
        СтрокаТЧ.ОтгруженоКоличество = 0;
    КонецЕсли;
    
    // Рассчитываем себестоимость для отображения в форме (опционально)
    Если СтрокаТЧ.ОтгруженоКоличество > 0 Тогда
        Себестоимость = ОбщийМодульСклад.ПолучитьСреднююСебестоимость(СтрокаТЧ.Номенклатура, Объект.Склад, Объект.Дата);
        СтрокаТЧ.Себестоимость = Себестоимость;
        СтрокаТЧ.СуммаСебестоимости = СтрокаТЧ.ОтгруженоКоличество * Себестоимость;
    КонецЕсли;
    
    // Сумма продажи (для клиента)
    СтрокаТЧ.Сумма = СтрокаТЧ.ОтгруженоКоличество * СтрокаТЧ.ЦенаПродажи;
КонецПроцедуры

