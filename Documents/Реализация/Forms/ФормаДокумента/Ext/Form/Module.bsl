// ФормаДокумента.Реализация  
&НаКлиенте
Процедура ТоварыПриИзменении(Элемент)
	 Индекс = Элементы.Товары.ТекущаяСтрока;
    Если Индекс <> Неопределено Тогда
                ОбновитьСтатусСтрокиНаСервере(Индекс);
        ПересчитатьСтрокуНаСервере(Индекс);
        
          КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусСтрокиНаСервере(ИндексСтроки)
    СтрокаТЧ = Объект.Товары[ИндексСтроки];
    
       Если СтрокаТЧ.ОтгруженоКоличество = Неопределено Тогда
        СтрокаТЧ.ОтгруженоКоличество = 0;
    КонецЕсли;
    
       СтрокаТЧ.ОстатокКОтгрузке = СтрокаТЧ.Количество - СтрокаТЧ.ОтгруженоКоличество;
    
        Если СтрокаТЧ.ОтгруженоКоличество <= 0 Тогда
        СтрокаТЧ.СтатусОтгрузки = Перечисления.СтатусыОтгрузки.ОжидаетОтгрузки;
    ИначеЕсли СтрокаТЧ.ОтгруженоКоличество < СтрокаТЧ.Количество Тогда
        СтрокаТЧ.СтатусОтгрузки = Перечисления.СтатусыОтгрузки.Частично;
    Иначе
        СтрокаТЧ.СтатусОтгрузки = Перечисления.СтатусыОтгрузки.Отгружено;
    КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ТоварыЦенаПродажиПриИзменении(Элемент)
    Индекс = Элементы.Товары.ТекущаяСтрока;
    Если Индекс <> Неопределено Тогда
        ПересчитатьСтрокуНаСервере(Индекс);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСтрокуНаСервере(ИндексСтроки)
    СтрокаТЧ = Объект.Товары[ИндексСтроки];
    
       Если СтрокаТЧ.ОтгруженоКоличество = Неопределено Тогда
        СтрокаТЧ.ОтгруженоКоличество = 0;
    КонецЕсли;
    
    Если СтрокаТЧ.ОтгруженоКоличество > 0 Тогда
        Себестоимость = ОбщийМодульСклад.ПолучитьСреднююСебестоимость(СтрокаТЧ.Номенклатура, Объект.Склад, Объект.Дата);
        СтрокаТЧ.Себестоимость = Себестоимость;
        СтрокаТЧ.СуммаСебестоимости = СтрокаТЧ.ОтгруженоКоличество * Себестоимость;
    КонецЕсли;
    
       СтрокаТЧ.Сумма = СтрокаТЧ.ОтгруженоКоличество * СтрокаТЧ.ЦенаПродажи;
КонецПроцедуры

&НаСервере
Процедура ПроверитьОстатокНаСервере(ИндексСтроки)
	Попытка
    СтрокаТЧ = Объект.Товары[ИндексСтроки];
    
     
 
    Если (СтрокаТЧ.Номенклатура <> NULL И СтрокаТЧ.Количество <> NULL) Тогда
        КонецЕсли;
	Исключение 
		 Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры


&НаКлиенте
Процедура ЧастичноеСписание(Команда)
      ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("ТекущаяСтрока", Элементы.Товары.ТекущиеДанные);
    ПараметрыФормы.Вставить("Документ", Объект);
    
    ОткрытьФорму("Документ.Реализация.Форма.ЧастичноеСписание", ПараметрыФормы);
КонецПроцедуры

&НаКлиенте
Процедура СписатьКоличество(ДокументРеализации, СтрокаТЧ, КоличествоСписания, ИндексСтроки)
   
    Если КоличествоСписания <= 0 Тогда
        Возврат;
    КонецЕсли;
    
    Если КоличествоСписания > СтрокаТЧ.Количество Тогда
        Сообщить("Количество списания не может превышать заказанное количество!");
        Возврат;
    КонецЕсли;
    
        СписатьКоличествоНаСервере(ДокументРеализации, ИндексСтроки, КоличествоСписания);
КонецПроцедуры
&НаСервере
Процедура СписатьКоличествоНаСервере(ДокументРеализации, ИндексСтроки, КоличествоСписания)
    СтрокаТЧ = ДокументРеализации.Товары[ИндексСтроки];
    
       Если СтрокаТЧ.ОтгруженоКоличество = Неопределено Тогда
        СтрокаТЧ.ОтгруженоКоличество = 0;
    КонецЕсли;
    
    ОсталосьКОтгрузке = СтрокаТЧ.Количество - СтрокаТЧ.ОтгруженоКоличество;
    Если КоличествоСписания > ОсталосьКОтгрузке Тогда
        Сообщить("⚠️ Нельзя списать больше, чем осталось к отгрузке!");
        Возврат;
    КонецЕсли;
    
       СтрокаТЧ.ОтгруженоКоличество = СтрокаТЧ.ОтгруженоКоличество + КоличествоСписания;
    СтрокаТЧ.ОстатокКОтгрузке = СтрокаТЧ.Количество - СтрокаТЧ.ОтгруженоКоличество;
    
       Если СтрокаТЧ.ОтгруженоКоличество <= 0 Тогда
        СтрокаТЧ.СтатусОтгрузки = Перечисления.СтатусыРеализации.ОжидаетОтгрузки;
    ИначеЕсли СтрокаТЧ.ОтгруженоКоличество < СтрокаТЧ.Количество Тогда
        СтрокаТЧ.СтатусОтгрузки = Перечисления.СтатусыРеализации.Частично;
    Иначе
        СтрокаТЧ.СтатусОтгрузки = Перечисления.СтатусыРеализации.Отгружено;
    КонецЕсли;
    
        СтрокаТЧ.Сумма = СтрокаТЧ.ОтгруженоКоличество * СтрокаТЧ.ЦенаПродажи;
КонецПроцедуры

&НаКлиенте
Процедура ОтгрузитьПолностью(Команда)
    ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда
        Сообщить("⚠️ Выберите строку товара!");
        Возврат;
    КонецЕсли;
    
       Если ТекущаяСтрока.ОтгруженоКоличество = ТекущаяСтрока.Количество Тогда
        Сообщить("⚠️ Товар уже полностью отгружен!");
        Возврат;
    КонецЕсли;
    
       Осталось = ТекущаяСтрока.Количество - ТекущаяСтрока.ОтгруженоКоличество;
    СписатьКоличествоНаСервере(Объект, Элементы.Товары.ТекущаяСтрока, Осталось);
КонецПроцедуры
