&НаКлиенте
Процедура СписатьКоличество(ДокументРеализации, СтрокаТЧ, КоличествоСписания, ИндексСтроки)
    // Проверяем возможность списания
    Если КоличествоСписания <= 0 Тогда
        Возврат;
    КонецЕсли;
    
    Если КоличествоСписания > СтрокаТЧ.Количество Тогда
        Сообщить("Количество списания не может превышать заказанное количество!");
        Возврат;
    КонецЕсли;
    
    // ✅ Вызываем серверную процедуру с индексом
    СписатьКоличествоНаСервере(ДокументРеализации, ИндексСтроки, КоличествоСписания);
КонецПроцедуры
&НаСервере
Процедура СписатьКоличествоНаСервере(ДокументРеализации, ИндексСтроки, КоличествоСписания)
    СтрокаТЧ = ДокументРеализации.Товары[ИндексСтроки];
    
    // ✅ ИЗМЕНЕНИЕ 1: Проверяем, что не списываем больше, чем осталось
    Если СтрокаТЧ.ОтгруженоКоличество = Неопределено Тогда
        СтрокаТЧ.ОтгруженоКоличество = 0;
    КонецЕсли;
    
    ОсталосьКОтгрузке = СтрокаТЧ.Количество - СтрокаТЧ.ОтгруженоКоличество;
    Если КоличествоСписания > ОсталосьКОтгрузке Тогда
        Сообщить("⚠️ Нельзя списать больше, чем осталось к отгрузке!");
        Возврат;
    КонецЕсли;
    
    // ✅ ИЗМЕНЕНИЕ 2: Увеличиваем отгруженное количество (не заменяем!)
    СтрокаТЧ.ОтгруженоКоличество = СтрокаТЧ.ОтгруженоКоличество + КоличествоСписания;
    СтрокаТЧ.ОстатокКОтгрузке = СтрокаТЧ.Количество - СтрокаТЧ.ОтгруженоКоличество;
    
    // ✅ ИЗМЕНЕНИЕ 3: Обновляем статус
    Если СтрокаТЧ.ОтгруженоКоличество <= 0 Тогда
        СтрокаТЧ.СтатусОтгрузки = Перечисления.СтатусыРеализации.ОжидаетОтгрузки;
    ИначеЕсли СтрокаТЧ.ОтгруженоКоличество < СтрокаТЧ.Количество Тогда
        СтрокаТЧ.СтатусОтгрузки = Перечисления.СтатусыРеализации.Частично;
    Иначе
        СтрокаТЧ.СтатусОтгрузки = Перечисления.СтатусыРеализации.Отгружено;
    КонецЕсли;
    
    // ✅ ИЗМЕНЕНИЕ 4: Обновляем сумму
    СтрокаТЧ.Сумма = СтрокаТЧ.ОтгруженоКоличество * СтрокаТЧ.ЦенаПродажи;
КонецПроцедуры

