Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
		
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Покупатель = Справочники.Контрагенты.ПустаяСсылка() Тогда
		Сообщить("Выберите покупателя!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Склад = Справочники.Склады.ПустаяСсылка() Тогда
		Сообщить("Выберите склад!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Товары.Количество() = 0 Тогда
		Сообщить("Добавьте хотя бы один товар!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
		ПересчитатьСуммы();
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения) Экспорт
	Если Не ПроверитьОстатки() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
		СформироватьДвижения();
	Движения.ТоварыНаСкладе.Записывать = Истина;
	Движения.РезервыНовый.Записывать = Истина;
КонецПроцедуры

Процедура ОбработкаОтменыПроведения(Отказ, РежимОтменыПроведения)
	Движения.ТоварыНаСкладе.Очистить();
	Движения.РезервыНовый.Очистить();
	Движения.ТоварыНаСкладе.Записывать = Истина;
	Движения.РезервыНовый.Записывать = Истина;
КонецПроцедуры


Процедура СформироватьДвижения() Экспорт
		Движения.ТоварыНаСкладе.Очистить();
	Движения.РезервыНовый.Очистить();
	
	Для Каждого СтрокаТЧ Из Товары Цикл
				КоличествоДляСписания = ?(СтрокаТЧ.ОтгруженоКоличество = Неопределено, 
		СтрокаТЧ.Количество, 
		СтрокаТЧ.ОтгруженоКоличество);
		
		Если КоличествоДляСписания <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
				Себестоимость = ОбщийМодульСклад.ПолучитьСреднююСебестоимость(СтрокаТЧ.Номенклатура, Склад, Дата);
		
		
		Если Себестоимость = 0 Тогда
					Себестоимость = СтрокаТЧ.ЦенаПродажи * 0.8;
		КонецЕсли;
		
				СтрокаТЧ.Себестоимость = Себестоимость;
		СтрокаТЧ.СуммаСебестоимости = КоличествоДляСписания * Себестоимость;
		
				ДвижениеСклад = Движения.ТоварыНаСкладе.Добавить();
		ДвижениеСклад.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеСклад.Период = Дата;
		ДвижениеСклад.Склад = Склад;
		ДвижениеСклад.Номенклатура = СтрокаТЧ.Номенклатура;
		ДвижениеСклад.Количество = -КоличествоДляСписания;
		ДвижениеСклад.Сумма = СтрокаТЧ.Сумма;
		ДвижениеСклад.ОбщаяСтоимость = СтрокаТЧ.СуммаСебестоимости;  		
				
			Если СпособРеализации = Перечисления.СпособыРеализации.СРезерва Тогда
			ПолучитьВсеРезервы();
			
			СнятьРезерв(СтрокаТЧ);
		ИначеЕсли СпособРеализации = Перечисления.СпособыРеализации.СоСклада Тогда
			Продолжить;
		Иначе 			
			СнятьРезервЕслиЕсть(СтрокаТЧ);
			
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
		Процедура СнятьРезерв(СтрокаРеализации)
		Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РезервыНовый.Склад,
	|	РезервыНовый.Номенклатура,
	|	РезервыНовый.КоличествоРезерва
	|ИЗ
	|	РегистрНакопления.РезервыНовый КАК РезервыНовый
	|ГДЕ
	|	РезервыНовый.Номенклатура = &Номенклатура
	|	И РезервыНовый.Склад = &Склад
	|	И РезервыНовый.ДатаСписания >= &Период
	|СГРУППИРОВАТЬ ПО
	|	РезервыНовый.Склад,
	|	РезервыНовый.КоличествоРезерва,
	|	РезервыНовый.Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", СтрокаРеализации.Номенклатура);
	
	
	Запрос.УстановитьПараметр("Склад", Склад);
	
	Запрос.УстановитьПараметр("Период", ДатаРеализации);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ОсталосьСписать = СтрокаРеализации.Количество;
	Попытка
		Пока Выборка.Следующий() И ОсталосьСписать > 0 Цикл
			
			
			КоличествоСписания = Мин(ОсталосьСписать, Выборка.КоличествоРезерва);
			
			Движение = Движения.РезервыНовый.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.Склад = Выборка.Склад;
			Движение.Номенклатура = Выборка.Номенклатура;
			Движение.КоличествоРезерва = -КоличествоСписания;  			
			ОсталосьСписать = ОсталосьСписать - КоличествоСписания;
		КонецЦикла;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки; 
	Если ОсталосьСписать > 0 Тогда
		ВызватьИсключение "Недостаточно резерва для товара1 " + 
		СтрокаРеализации.Номенклатура.Наименование + 
		". Остаток резерва: " + 
		Формат(СтрокаРеализации.Количество - ОсталосьСписать, "ЧДЦ=2");
	КонецЕсли;
КонецПроцедуры
Процедура ПолучитьВсеРезервы() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Резервы.Номенклатура КАК НоменклатураСсылка,
	|	Резервы.Склад КАК СкладСсылка,
	|	Резервы.КоличествоРезерва КАК Количество
	|ИЗ
	|	РегистрНакопления.РезервыНовый КАК Резервы";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
КонецПроцедуры


Функция ПолучитьФизическийОстаток(Номенклатура, Склад, ДатаПериода) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|    ЕСТЬNULL(СУММА(ТоварыНаСкладе.Количество), 0) КАК ФизическийОстаток
	|ИЗ
	|    РегистрНакопления.ТоварыНаСкладе КАК ТоварыНаСкладе
	|ГДЕ
	|    ТоварыНаСкладе.Номенклатура = &Номенклатура
	|    И ТоварыНаСкладе.Склад = &Склад
	|    И ТоварыНаСкладе.Период <= &Период
	|СГРУППИРОВАТЬ ПО
	|    ТоварыНаСкладе.Номенклатура
	|";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Период", ДатаПериода);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ФизическийОстаток;
	КонецЕсли;
	
	Возврат 0;
КонецФункции

Процедура СнятьРезервЕслиЕсть(СтрокаРеализации)
	// Снимаем резерв, если есть, остальное со склада
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|    
	|    РезервыНовый.Склад,
	|    РезервыНовый.Номенклатура,
	|    РезервыНовый.КоличествоРезерва
	|ИЗ
	|    РегистрНакопления.РезервыНовый КАК РезервыНовый
	|ГДЕ
	|    РезервыНовый.Номенклатура = &Номенклатура
	|    И РезервыНовый.Склад = &Склад
	|    И РезервыНовый.КоличествоРезерва > 0
	|УПОРЯДОЧИТЬ ПО
	|    РезервыНовый.Период
	|";
	
	Запрос.УстановитьПараметр("Номенклатура", СтрокаРеализации.Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ОсталосьСписать = СтрокаРеализации.Количество;
	
	Пока Выборка.Следующий() И ОсталосьСписать > 0 Цикл
		КоличествоСписания = Мин(ОсталосьСписать, Выборка.КоличествоРезерва);
		
		Движение = Движения.РезервыНовый.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Склад = Выборка.Склад;
		Движение.Номенклатура = Выборка.Номенклатура;
		Движение.КоличествоРезерва = -КоличествоСписания;  		
		ОсталосьСписать = ОсталосьСписать - КоличествоСписания;
	КонецЦикла;
	Если ОсталосьСписать > 0 Тогда
	КонецЕсли;
КонецПроцедуры

Функция ПроверитьОстатки() Экспорт
	Для Каждого СтрокаТЧ Из Товары Цикл
		// Получаем свободный остаток
		СвободныйОстаток = ПолучитьСвободныйОстаток(СтрокаТЧ.Номенклатура, Склад, ДатаРеализации);
				Если СпособРеализации = Перечисления.СпособыРеализации.СРезерва Тогда
						Резерв = ПолучитьРезерв(СтрокаТЧ.Номенклатура, Склад);
			
				Если Резерв < СтрокаТЧ.Количество Тогда
				Текст = "Недостаточно резерва!" + Символы.ПС +
				"Товар: " + СтрокаТЧ.Номенклатура.Наименование + Символы.ПС +
				"Резерв: " + Формат(Резерв, "ЧДЦ=2") + Символы.ПС +
				"Запрошено: " + Формат(СтрокаТЧ.Количество, "ЧДЦ=2");
				Сообщить(Текст);
				Возврат Ложь;
			КонецЕсли;
		Иначе
						Если СвободныйОстаток < СтрокаТЧ.Количество Тогда
				Текст = "Недостаточно товара на складе!" + Символы.ПС +
				"Товар: " + СтрокаТЧ.Номенклатура.Наименование + Символы.ПС +
				"Свободный остаток: " + Формат(СвободныйОстаток, "ЧДЦ=2") + Символы.ПС +
				"Запрошено: " + Формат(СтрокаТЧ.Количество, "ЧДЦ=2");
				Сообщить(Текст);
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
КонецФункции

Функция ПолучитьСвободныйОстаток(Номенклатура, Склад, ДатаПериода) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СУММА(РезервыНовый.КоличествоРезерва) КАК КоличествоРезерва,
	|	РезервыНовый.Номенклатура КАК Номенклатура,
	|	РезервыНовый.Склад КАК Склад,
	|	РезервыНовый.Период КАК Период
	|ПОМЕСТИТЬ втРезервы
	|ИЗ
	|	РегистрНакопления.РезервыНовый КАК РезервыНовый
	|ГДЕ
	|	РезервыНовый.Номенклатура = &Номенклатура
	|	И РезервыНовый.Склад = &Склад
	|	И РезервыНовый.ДатаСписания >= &Период
	|СГРУППИРОВАТЬ ПО
	|	РезервыНовый.Номенклатура,
	|	РезервыНовый.Склад,
	|	РезервыНовый.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыНаСкладе.Склад КАК Склад,
	|	ТоварыНаСкладе.Номенклатура КАК Номенклатура,
	|	СУММА(ТоварыНаСкладе.Количество) КАК Количество
	|ПОМЕСТИТЬ ВтТоварыНаСкладе
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладе КАК ТоварыНаСкладе
	|ГДЕ
	|	ТоварыНаСкладе.Номенклатура = &Номенклатура
	|	И ТоварыНаСкладе.Склад = &Склад
	|	И ТоварыНаСкладе.Период <= &Период
	|СГРУППИРОВАТЬ ПО
	|	ТоварыНаСкладе.Склад,
	|	ТоварыНаСкладе.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ЕСТЬNULL(ТоварыНаСкладе.Количество, 0) - ЕСТЬNULL(РезервыНовый.КоличествоРезерва, 0)) КАК СвободныйОстаток,
	|	СУММА(ТоварыНаСкладе.Количество) КАК ФизическийОстаток,
	|	СУММА(ЕСТЬNULL(РезервыНовый.КоличествоРезерва, 0)) КАК Резерв,
	|	РезервыНовый.Номенклатура КАК Номенклатура,
	|	РезервыНовый.Склад КАК Склад
	|ИЗ
	|	ВтТоварыНаСкладе КАК ТоварыНаСкладе
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РезервыНовый КАК РезервыНовый
	|		ПО ТоварыНаСкладе.Номенклатура = РезервыНовый.Номенклатура
	|		И ТоварыНаСкладе.Склад = РезервыНовый.Склад
	|СГРУППИРОВАТЬ ПО
	|	РезервыНовый.Склад,
	|	РезервыНовый.Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Период",ДатаПериода );
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		
		
		Возврат Выборка.СвободныйОстаток;
	КонецЕсли;
	
	Возврат 0;
КонецФункции

Функция ПолучитьРезерв(Номенклатура, Склад) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|    ЕСТЬNULL(ТоварыНаСкладеОстатки.КоличествоОстаток, 0) Как КоличествоРезерва,
	|    ЕСТЬNULL(РезервыНовыйОстатки.КоличествоРезерваОстаток, 0) КАК СвободныйОстаток
	|ИЗ
	|    РегистрНакопления.ТоварыНаСкладе.Остатки(&Период, ) КАК ТоварыНаСкладеОстатки
	|        ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РезервыНовый.Остатки(&Период, ) КАК РезервыНовыйОстатки
	|        ПО ТоварыНаСкладеОстатки.Номенклатура = РезервыНовыйОстатки.Номенклатура
	|            И ТоварыНаСкладеОстатки.Склад = РезервыНовыйОстатки.Склад
	|ГДЕ
	|    ТоварыНаСкладеОстатки.Номенклатура = &Номенклатура
	|    И ТоварыНаСкладеОстатки.Склад = &Склад
	|";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Период", ДатаРеализации);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Возврат Выборка.КоличествоРезерва;
		
	КонецЦикла;
	
	Возврат 0;
КонецФункции

