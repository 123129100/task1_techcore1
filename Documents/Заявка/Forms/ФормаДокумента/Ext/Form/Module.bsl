&НаКлиенте
Процедура УслугиПриИзменении(Элемент)
    
    ТекущиеДанные = Элемент.ТекущиеДанные;
    Если ТекущиеДанные <> Неопределено Тогда
        ПересчитатьСтрокуНаСервере(ТекущиеДанные);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УслугиПослеУдаления(Элемент, Отказ)
   
    ПересчитатьИтогНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПересчитатьИтогНаСервере()
    ПересчитатьИтогДокумента();
КонецПроцедуры


&НаКлиенте
Процедура УстановитьРежимРедактирования()
    // Проверяем, проведен ли документ
    Если Объект.Проведен Тогда
  
      
        Элементы.Клиент.Доступность = Ложь;
        Элементы.Статус.Доступность = Ложь;
       Элементы.Дата.Доступность = Ложь;
      Элементы.Номер.Доступность = Ложь;
      
        Элементы.СуммаИтог.Доступность = Ложь;
        
       
        Элементы.Услуги.Доступность = Ложь;
        Элементы.УслугиКоличество.Доступность = Ложь;
        Элементы.УслугиЦена.Доступность = Ложь;
        Элементы.УслугиСумма.Доступность = Ложь;
        
  
       
        Элементы.УслугиДобавить.Доступность = Ложь;
        Элементы.УслугиУдалить.Доступность = Ложь;
        
       
        ЭтаФорма.КоманднаяПанель.Доступность = Ложь;
        
       
        Сообщить("⚠️ Документ проведен! Редактирование запрещено.");
    Иначе
        
        Элементы.Клиент.Доступность = Истина;
        Элементы.Статус.Доступность = Истина;
        Элементы.Дата.Доступность = Истина;
      Элементы.Номер.Доступность = Истина;
        Элементы.СуммаИтог.Доступность = Истина;
        
        Элементы.Услуги.Доступность = Истина;
        Элементы.УслугиКоличество.Доступность = Истина;
        Элементы.УслугиЦена.Доступность = Истина;
        Элементы.УслугиСумма.Доступность = Истина;
        
        Элементы.УслугиДобавить.Доступность = Истина;
        Элементы.УслугиУдалить.Доступность = Истина;
        
      
        
     

    КонецЕсли;
КонецПроцедуры
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьРежимРедактирования();
КонецПроцедуры
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	УстановитьРежимРедактирования();
КонецПроцедуры
