
&НаКлиенте
Процедура Печать(Команда)
	 ПоказатьПечатнуюФорму();
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПечатнуюФорму()
    // Формируем печатную форму на сервере
    ТабДок = ПолучитьПечатнуюФормуНаСервере();
    
    // Показываем печатную форму
    Если ТабДок <> Неопределено Тогда
        ТабДок.Показать("Печатная форма заявки №" + Объект.Номер);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьПечатнуюФормуНаСервере()
	Попытка
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
    Возврат ДокументОбъект.ПолучитьПечатнуюФорму();
    
	Исключение
		 Сообщить(ОписаниеОшибки());
	КонецПопытки;
КонецФункции







&НаКлиенте
Процедура УслугиКоличествоПриИзменении(Элемент)
    Индекс = Элементы.Услуги.ТекущаяСтрока;
    Если Индекс <> Неопределено Тогда
        ПересчитатьСтрокуНаСервере(Индекс);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УслугиЦенаПриИзменении(Элемент)
    Индекс = Элементы.Услуги.ТекущаяСтрока;
    Если Индекс <> Неопределено Тогда
        ПересчитатьСтрокуНаСервере(Индекс);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСтрокуНаСервере(ИндексСтроки)
    
    СтрокаТЧ = Объект.Услуги[ИндексСтроки];
    
    СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
    
    ПересчитатьИтогДокумента();
КонецПроцедуры

&НаСервере
Процедура ПересчитатьИтогДокумента()
   
    Итог = 0;
    Для каждого Строка Из Объект.Услуги Цикл

        Строка.Сумма = Строка.Количество * Строка.Цена;
        Итог = Итог + Строка.Сумма;
    КонецЦикла;
    
    Объект.СуммаИтог = Итог;
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСтрокуТЧНаСервере(СтрокаТЧ)
    // Серверный вызов для пересчета строки и итога
    СтрокаТЧ.СуммаИтог = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
    ПересчитатьИтогДокумента();
КонецПроцедуры


