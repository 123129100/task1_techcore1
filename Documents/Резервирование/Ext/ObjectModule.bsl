// ДокументОбъект.Резервирование

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Если Не ПроверитьСвободныеОстатки() Тогда
        Отказ = Истина;
        Возврат;
    КонецЕсли;
    Сообщить("jjjjjj");
    СформироватьДвижения();
     Движения.РезервыНовый.Записывать = Истина; 
КонецПроцедуры

Процедура СформироватьДвижения()
    // ✅ Используем регистр РезервыНовый
    Движения.РезервыНовый.Очистить();  // ← исправлено
    
    Для Каждого СтрокаТЧ Из Товары Цикл
        Движение = Движения.РезервыНовый.Добавить();  // ← исправлено
        Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
        Движение.Период = Дата;
         Движение.Клиент = Клиент;
        Движение.Склад = Склад;
        Движение.ДатаРезерва = ДатаРезерва;
        Движение.ДатаСписания = ДатаСнятияРезерва;
        Движение.Номенклатура = СтрокаТЧ.Номенклатура;
        Движение.КоличествоРезерва = СтрокаТЧ.Количество;
        
         Сообщить("jjjjjj");
    КонецЦикла;
КонецПроцедуры

Функция ПроверитьСвободныеОстатки() Экспорт
    СписокНоменклатуры = Новый СписокЗначений;
    Для Каждого СтрокаТЧ Из Товары Цикл
        СписокНоменклатуры.Добавить(СтрокаТЧ.Номенклатура);
    КонецЦикла;
    
    Остатки = ПолучитьСвободныеОстаткиДляСписка(СписокНоменклатуры, Склад, ДатаРезерва);
    
    Для Каждого СтрокаТЧ Из Товары Цикл
        СвободныйОстаток = Остатки[СтрокаТЧ.Номенклатура];
        
        Если СвободныйОстаток = Неопределено Тогда
            СвободныйОстаток = 0;
        КонецЕсли;
        
        Если СвободныйОстаток < СтрокаТЧ.Количество Тогда
            Текст = "Недостаточно свободного остатка для резерва!" + Символы.ПС +
                    "Товар: " + СтрокаТЧ.Номенклатура.Наименование + Символы.ПС +
                    "Свободный остаток: " + Формат(СвободныйОстаток, "ЧДЦ=2") + Символы.ПС +
                    "Запрошено: " + Формат(СтрокаТЧ.Количество, "ЧДЦ=2");
            Сообщить(Текст);
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    
    Возврат Истина;
КонецФункции

Функция ПолучитьСвободныеОстаткиДляСписка(СписокНоменклатуры, Склад, ДатаПериода) Экспорт
    Результат = Новый Соответствие;
    
    Если СписокНоменклатуры.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = "
    |ВЫБРАТЬ
    |    ТоварыНаСкладе.Номенклатура КАК Номенклатура,
    |    ЕСТЬNULL(СУММА(ТоварыНаСкладе.Количество), 0) - 
    |    ЕСТЬNULL(СУММА(РезервыНовый.КоличествоРезерва), 0) КАК СвободныйОстаток
    |ИЗ
    |    РегистрНакопления.ТоварыНаСкладе КАК ТоварыНаСкладе
    |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РезервыНовый КАК РезервыНовый
    |        ПО ТоварыНаСкладе.Склад = РезервыНовый.Склад
    |            И ТоварыНаСкладе.Номенклатура = РезервыНовый.Номенклатура
    |ГДЕ
    |    ТоварыНаСкладе.Склад = &Склад
    |    И ТоварыНаСкладе.Номенклатура В ИЕРАРХИИ (&НоменклатураСписок)
    |    И ТоварыНаСкладе.Период <= &Период
    |СГРУППИРОВАТЬ ПО
    |    ТоварыНаСкладе.Номенклатура
    |";
    
    Запрос.УстановитьПараметр("Склад", Склад);
    Запрос.УстановитьПараметр("Период", ДатаПериода);
    Запрос.УстановитьПараметр("НоменклатураСписок", СписокНоменклатуры);
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    Пока Выборка.Следующий() Цикл
        Результат.Вставить(Выборка.Номенклатура, Выборка.СвободныйОстаток);
    КонецЦикла;
    Попытка
    // ✅ Для товаров без остатков устанавливаем 0
    Для Каждого СтрокаСписка Из СписокНоменклатуры Цикл
    	Сообщить(Результат.Получить(СтрокаСписка.Значение));
        Если Не Результат.Получить(СтрокаСписка.Значение) Тогда
            Результат.Вставить(СтрокаСписка.Значение, 0);
        КонецЕсли;
    КонецЦикла;
    Исключение
    	Сообщить(ОписаниеОшибки());
    КонецПопытки;
    Возврат Результат;
КонецФункции

// ✅ Функция автоматического снятия резерва
Функция АвтоматическоеСнятиеРезерва(ДокументРезерва) Экспорт
    Для Каждого СтрокаТЧ Из ДокументРезерва.Товары Цикл
        СрокРезерва = СтрокаТЧ.Номенклатура.СрокРезерва;
        
        Если СрокРезерва = 0 ИЛИ СрокРезерва = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        
        Если ДокументРезерва.ДатаРезерва + СрокРезерва * 24 * 60 * 60 < ТекущаяДата() Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    
    Возврат Ложь;
КонецФункции