// ОбщийМодуль.РаботаСРезервами

Процедура АвтоматическоеСнятиеРезерва() Экспорт
    // Запрос на поиск просроченных резервов
    Запрос = Новый Запрос;
    Запрос.Текст = "
    |ВЫБРАТЬ
    |    РезервыТоваров.ДокументРезерва КАК ДокументРезерва,
    |    РезервыТоваров.Склад КАК Склад,
    |    РезервыТоваров.Номенклатура КАК Номенклатура,
    |    РезервыТоваров.КоличествоРезерва КАК Количество
    |ИЗ
    |    РегистрНакопления.РезервыТоваров КАК РезервыТоваров
    |ГДЕ
    |    РезервыТоваров.Период <= &ДатаСнятия
    |    И РезервыТоваров.КоличествоРезерва > 0
    |";
    
    Запрос.УстановитьПараметр("ДатаСнятия", ТекущаяДата() - 30);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Пока Выборка.Следующий() Цикл
        // Создаем документ снятия резерва
        ДокСнятие = Документы.СнятиеРезерва.СоздатьДокумент();
        ДокСнятие.ДокументРезерва = Выборка.ДокументРезерва;
        ДокСнятие.Склад = Выборка.Склад;
        ДокСнятие.Дата = ТекущаяДата();
        
        СтрокаТЧ = ДокСнятие.Товары.Добавить();
        СтрокаТЧ.Номенклатура = Выборка.Номенклатура;
        СтрокаТЧ.Количество = Выборка.Количество;
        
        ДокСнятие.Записать(РежимЗаписиДокумента.Проведение);
    КонецЦикла;
КонецПроцедуры