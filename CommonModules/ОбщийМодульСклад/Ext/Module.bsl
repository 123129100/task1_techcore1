// ОбщийМодуль.Склад

// Получить среднюю себестоимость товара

Функция ПолучитьСреднююСебестоимость(Номенклатура, Склад, ДатаПериода) Экспорт
    
    Запрос = Новый Запрос;
    Запрос.Текст = "
    |ВЫБРАТЬ
    |    СУММА(Товары.Количество) КАК Количество,
    |    СУММА(Товары.ОбщаяСтоимость) КАК ОбщаяСтоимость
    |ИЗ
    |    РегистрНакопления.ТоварыНаСкладе КАК Товары
    |ГДЕ
    |    Товары.Номенклатура = &Номенклатура
    |    И Товары.Склад = &Склад
    |    И Товары.Период <= &Период
    |    И Товары.ВидДвижения = &ВидПриход
    |СГРУППИРОВАТЬ ПО
    |    Товары.Номенклатура
    |";
    
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Запрос.УстановитьПараметр("Склад", Склад);
    Запрос.УстановитьПараметр("Период", ДатаПериода);
    Запрос.УстановитьПараметр("ВидПриход", ВидДвиженияНакопления.Приход);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Если Выборка.Следующий() Тогда
        Если Выборка.Количество > 0 Тогда
                        Возврат Выборка.ОбщаяСтоимость / Выборка.Количество;
        КонецЕсли;
    КонецЕсли;
    
       Возврат 0;
КонецФункции

//  Получить себестоимость по FIFO (для списания)

Функция ПолучитьСебестоимостьFIFO(Номенклатура, Склад, ДатаПериода, КоличествоСписания) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = "
    |ВЫБРАТЬ
    |    Товары.Количество,
    |    Товары.ОбщаяСтоимость,
    |    Товары.ОбщаяСтоимость / Товары.Количество КАК Цена,
    |    Товары.Период
    |ИЗ
    |    РегистрНакопления.ТоварыНаСкладе КАК Товары
    |ГДЕ
    |    Товары.Номенклатура = &Номенклатура
    |    И Товары.Склад = &Склад
    |    И Товары.Период <= &Период
    |    И Товары.ВидДвижения = &ВидПриход
    |    И Товары.Количество > 0
    |УПОРЯДОЧИТЬ ПО
    |    Товары.Период  // FIFO: сначала старые
    |";
    
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Запрос.УстановитьПараметр("Склад", Склад);
    Запрос.УстановитьПараметр("Период", ДатаПериода);
    Запрос.УстановитьПараметр("ВидПриход", ВидДвиженияНакопления.Приход);
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    ОсталосьСписать = КоличествоСписания;
    ОбщаяСебестоимость = 0;
    
    Пока Выборка.Следующий() И ОсталосьСписать > 0 Цикл
        Списываем = Мин(ОсталосьСписать, Выборка.Количество);
        ОбщаяСебестоимость = ОбщаяСебестоимость + Списываем * Выборка.Цена;
        ОсталосьСписать = ОсталосьСписать - Списываем;
    КонецЦикла;
    
    Если КоличествоСписания > 0 Тогда
        Возврат ОбщаяСебестоимость / КоличествоСписания;
    КонецЕсли;
    
    Возврат 0;
КонецФункции

// Обновить сумму в строке ТЧ


Процедура ОбновитьСтрокуТЧ(СтрокаТЧ) Экспорт
    Если СтрокаТЧ.Количество > 0 И СтрокаТЧ.ЦенаЗакупки > 0 Тогда
        СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.ЦенаЗакупки;
    КонецЕсли;
КонецПроцедуры